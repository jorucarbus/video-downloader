# ========================================
# Video Downloader & Editor
# .env.example → Copiar a .env
# ========================================

# ---- API Keys ----
GEMINI_API_KEY=tu_gemini_api_key_aqui
OPENAI_API_KEY=tu_openai_api_key_aqui

# ---- Google Drive (OAuth) ----
# Puede reusar las mismas credenciales OAuth de otro proyecto tuyo con acceso
# ya autorizado a las carpetas de Drive que necesitas (evita crear un service
# account nuevo). Regenerar con el flujo de consentimiento de Google si expira
# ("invalid_grant") — recordar actualizar en TODOS los .env/Railway que lo compartan.
GOOGLE_OAUTH_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=tu_client_secret
GOOGLE_OAUTH_REFRESH_TOKEN=tu_refresh_token

# Carpeta raíz de videos (ID de Google Drive)
GOOGLE_DRIVE_VIDEOS_FOLDER_ID=tu_folder_id_videos_famosos

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Paths (Local) ----
TEMP_VIDEOS_DIR=./backend/temp-videos
DOWNLOADS_DIR=~/Descargas/Videos_Editados

# ---- Electron ----
ELECTRON_ENV=development

# ---- Logging ----
LOG_LEVEL=debug

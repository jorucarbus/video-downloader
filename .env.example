# ========================================
# Video Downloader & Editor
# .env.example → Copiar a .env
# ========================================

# ---- API Keys ----
GEMINI_API_KEY=tu_gemini_api_key_aqui
OPENAI_API_KEY=tu_openai_api_key_aqui

# ---- Google Drive ----
# Service Account JSON (completo, incluir comillas)
GOOGLE_DRIVE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Carpeta raíz de videos (ID de Google Drive)
GOOGLE_DRIVE_VIDEOS_FOLDER_ID=tu_folder_id_videos_famosos

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Paths (Local) ----
TEMP_VIDEOS_DIR=./backend/temp-videos
DOWNLOADS_DIR=~/Descargas/Videos_Editados

# ---- Electron ----
ELECTRON_ENV=development

# ---- Logging ----
LOG_LEVEL=debug
